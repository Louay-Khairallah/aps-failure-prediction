    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.metrics import confusion_matrix\n",
    "\n",
    "# Test thresholds from 0.01 to 0.50\n",
    "thresholds = np.arange(0.01, 0.51, 0.01)\n",
    "\n",
    "threshold_results = []\n",
    "\n",
    "for model_name, (model, probabilities) in models.items():\n",
    "\n",
    "    for threshold in thresholds:\n",
    "\n",
    "        # Convert probabilities to class predictions\n",
    "        predictions = (probabilities >= threshold).astype(int)\n",
    "\n",
    "        # Calculate the number of each type of mistake\n",
    "        tn, fp, fn, tp = confusion_matrix(\n",
    "            y_val,\n",
    "            predictions,\n",
    "            labels=[0, 1]\n",
    "        ).ravel()\n",
    "\n",
    "        # Calculate the challenge cost\n",
    "        cost = 10 * fp + 500 * fn\n",
    "\n",
    "        threshold_results.append({\n",
    "            \"Model\": model_name,\n",
    "            \"Threshold\": threshold,\n",
    "            \"False_Positives\": fp,\n",
    "            \"False_Negatives\": fn,\n",
    "            \"True_Positives\": tp,\n",
    "            \"Challenge_Cost\": cost\n",
    "        })\n",
    "\n",
    "# Convert results to a DataFrame\n",
    "threshold_results = pd.DataFrame(threshold_results)\n",
    "\n",
    "# Show the lowest-cost combinations\n",
    "best_results = threshold_results.sort_values(\n",
    "    by=\"Challenge_Cost\",\n",
    "    ascending=True\n",
    ")\n",
    "\n",
    "display(best_results.head(10).round(4))\n",
    "\n",
    "# Select the best model and threshold using validation cost\n",
    "best_row = best_results.iloc[0]\n",
    "\n",
    "best_model_name = best_row[\"Model\"]\n",
    "best_threshold = float(best_row[\"Threshold\"])\n",
    "best_model = models[best_model_name][0]\n",
    "\n",
    "print(\"\\nSelected model:\", best_model_name)\n",
    "print(\"Selected threshold:\", round(best_threshold, 2))\n",
    "print(\"Validation challenge cost:\", int(best_row[\"Challenge_Cost\"]))"
   ]
  },
